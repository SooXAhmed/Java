node('agent2') {

    def jdkHome = tool name: 'jdk-11', type: 'jdk'
    def mavenHome = tool name: 'maven-354', type: 'maven'

    withEnv([
        "JAVA_HOME=${jdkHome}",
        "PATH+JAVA=${jdkHome}/bin",
        "PATH+MAVEN=${mavenHome}/bin"
    ]) {

        withCredentials([
            string(credentialsId: 'Docker-username', variable: 'DOCKER_USER'),
            string(credentialsId: 'Docker-password', variable: 'DOCKER_PASS')
        ]) {

stage('Clone Repository') {
    git branch: 'main',
        url: 'https://github.com/SooXAhmed/Java.git'
}

            stage('Check Files') {
                sh 'pwd'
                sh 'ls -la'
            }

            stage('Build Java app') {
                sh 'mvn package -DskipTests'
            }

            stage('Test Java app') {
                sh 'mvn test'
            }

            stage('Archive Java app') {
                archiveArtifacts artifacts: '**/*.jar', followSymlinks: false
            }

            stage('Build Docker image') {
                sh 'docker build -t java-app-img1:v1 .'
            }

        }
    }
}